# Copy to .env.local and fill in. Everything here is optional.
# Tracking tools only load AFTER the visitor accepts that cookie category (see docs/cookie-consent.md).

# Google Analytics 4 measurement ID, e.g. G-ABC123XYZ9. Loads only with "Analytics" consent.
NEXT_PUBLIC_GA_ID=

# Meta (Facebook) pixel ID, digits only. Loads only with "Marketing" consent.
NEXT_PUBLIC_META_PIXEL_ID=

# Share the consent cookie across subdomains, e.g. .flipandshare.com (leave empty for the current host only).
NEXT_PUBLIC_COOKIE_DOMAIN=
